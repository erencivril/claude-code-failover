{
  "description": "Failover: record the conversation, catch stopped turns, hand off, and deliver the result.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"", "timeout": 10 }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"", "asyncRewake": true, "timeout": 7200 }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hook.sh\"", "timeout": 10 }
        ]
      }
    ]
  }
}
